[Unit]
Description=LLVM IR batch converter
Documentation=man:systemd.service(5)
After=local-fs.target
ConditionPathExists=/usr/lib/llvmir-convert/bin/llvmir_batch_runner.py

[Service]
Type=simple
EnvironmentFile=-/etc/default/llvmir-converter
WorkingDirectory=/var/lib/llvmir-converter

ExecStart=/bin/sh -eu -c 'exec "$${LLVMIR_CONVERTER_DIR:-/usr/lib/llvmir-convert/bin}/llvmir_batch_runner.py" --converter-dir="$${LLVMIR_CONVERTER_DIR:-/usr/lib/llvmir-convert/bin}" --output-dir="$${LLVMIR_OUTPUT_DIR:-/var/lib/llvmir-converter/normal}" --pgo-output="$${LLVMIR_PGO_OUTPUT_DIR:-/var/lib/llvmir-converter/pgo}" --pgo-profiles-output="$${LLVMIR_PGO_PROFILES_OUTPUT_DIR:-/var/lib/llvmir-converter/pgo-profraw}" --cpu-limit="$${LLVMIR_CPU_LIMIT:-90}" --cpu-resume="$${LLVMIR_CPU_RESUME:-60}" --memory-limit="$${LLVMIR_MEMORY_LIMIT:-85}" --memory-resume="$${LLVMIR_MEMORY_RESUME:-70}" --scan-interval="$${LLVMIR_SCAN_INTERVAL:-5}" --monitor-interval="$${LLVMIR_MONITOR_INTERVAL:-1}" $${LLVMIR_RUNNER_FLAGS:-} ${LLVMIR_INPUT_PATHS}'

Restart=on-failure
RestartSec=30s
KillMode=control-group
TimeoutStopSec=30s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/llvmir-converter
MemoryAccounting=yes

[Install]
WantedBy=multi-user.target